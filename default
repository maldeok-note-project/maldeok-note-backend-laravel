# Azure App Service(PHP 8.x / Linux)用の nginx 設定
# 起動時にこのファイルで /etc/nginx/sites-available/default を上書きする
# 元ファイル:Azure上の既定の設定をコピーし、Laravel用に一部だけ変更

server {
    #proxy_cache cache;
    #proxy_cache_valid 200 1s;
    listen 8080;
    listen [::]:8080;

    # 【変更①】入口を Laravel の public フォルダにする
    root /home/site/wwwroot/public;

    index  index.php index.html index.htm;
    server_name  example.com www.example.com;
    port_in_redirect off;

    location / {
        index  index.php index.html index.htm hostingstart.html;
        # 【変更②】ファイルが見つからないURL(/api/... など)は、すべて index.php に渡す
        # これがないと、Laravel のルーティングが動かず 404 になる
        try_files $uri $uri/ /index.php?$args;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /html/;
    }

    # .git フォルダへのアクセスを禁止(元の設定のまま)
    location ~ /\.git {
        deny all;
        access_log off;
        log_not_found off;
    }

    # PHP ファイルを PHP-FPM(PHPの実行係)に渡す設定(元の設定のまま)
    location ~* [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.[Pp][Hh][Pp])(|/.*)$;
        fastcgi_pass 127.0.0.1:9000;
        include fastcgi_params;
        fastcgi_param HTTP_PROXY "";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param QUERY_STRING $query_string;
        # 【変更③】Laravel が返す JSON のエラー(500など)を、nginx の HTML エラー画面で上書きしない
        # APIなので、フロント(React)が JSON のエラー内容を受け取れるようにするため
        fastcgi_intercept_errors off;
        fastcgi_connect_timeout         300;
        fastcgi_send_timeout           3600;
        fastcgi_read_timeout           3600;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
    }
}